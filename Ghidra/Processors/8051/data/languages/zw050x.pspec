<?xml version="1.0" encoding="UTF-8"?>
<processor_spec>
  <programcounter register="PC"/>
  <volatile outputop="write_volatile" inputop="read_volatile">
    <!-- SFRPAGE is control state used to translate CODE addresses in p-code. -->
    <range space="SFR" first="0x80" last="0xfe"/>
    <range space="BITS" first="0x80" last="0xff"/>
  </volatile>
  <default_symbols>
    <symbol name="P2" address="SFR:a0"/>
    <symbol name="SFRPAGE" address="SFR:ff"/>
  </default_symbols>
  <default_memory_blocks>
    <memory_block name="IDATA" start_address="INTMEM:0" length="0x100" initialized="false"/>
    <memory_block name="XDATA" start_address="EXTMEM:0" length="0x10000" initialized="false"/>
    <memory_block name="SFR" start_address="SFR:80" length="0x80" initialized="false"/>
    <memory_block name="IRAM_BITS" start_address="BITS:00" bit_mapped_address="INTMEM:20" length="0x80"/>
    <memory_block name="SFR_BITS" start_address="BITS:80" length="0x80" initialized="false"/>
  </default_memory_blocks>
</processor_spec>
